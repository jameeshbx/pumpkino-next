# ── Database ────────────────────────────────────────────────────────────────
# Used by the app (running on the host) to reach the dockerised PostgreSQL.
DATABASE_URL="postgresql://pumpkino:pumpkino_dev_password@localhost:5433/pumpkino?schema=public"

# Used by docker-compose to provision the PostgreSQL container.
POSTGRES_USER=pumpkino
POSTGRES_PASSWORD=pumpkino_dev_password
POSTGRES_DB=pumpkino
# Host port the dockerised PostgreSQL is exposed on.
POSTGRES_HOST_PORT=5433

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Rotation: AUTH_SECRET accepts the current secret; sessions signed with an
# old secret are invalidated on rotation (JWT strategy).
AUTH_SECRET="dev-only-secret-change-me-32-chars-min!!"
# Base URL of the app (used by NextAuth for callbacks and secure cookies).
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Seed (development only — override in real deployments) ─────────────────
SEED_ADMIN_EMAIL="ops@pumpkino.test"
SEED_ADMIN_PASSWORD="ChangeMe!Ops2026"
